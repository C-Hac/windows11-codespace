{
  "name": "Windows 11 Codespace",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "dockerDashComposeVersion": "latest"
    }
  },
  "forwardPorts": [
    8006,
    3389
  ],
  "portsAttributes": {
    "8006": {
      "label": "Windows 11 noVNC",
      "onAutoForward": "openBrowser"
    },
    "3389": {
      "label": "Windows RDP",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "echo 'Windows 11 Codespace ready'"
}
